# src/frontend/.env.local.example
#
# In normal Aspire-orchestrated runs (via ProjectName.AppHost), AGUI_SERVER_URL
# is injected automatically — see AppHost.cs:
#   .WithEnvironment("AGUI_SERVER_URL", $"{orchestratorService.GetEndpoint(\"http\")}/agui")
#
# This file is only needed if you run `npm run dev` standalone, outside Aspire
# (e.g. against an OrchestratorService already running via `dotnet run`).
# Copy to .env.local and adjust the port to match your local run.
AGUI_SERVER_URL=http://localhost:5100/agui
