<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ═══════════════════════════════════════════════════════════════
    PROJECTNAME — MCP.FILESYSTEM
    Identity  : Filesystem Actuator (MCP Server)
    Law Anchor: ARCH-012, ARCH-013, FS-LAW-001, FRAC-MCP-400-001
    ═══════════════════════════════════════════════════════════════
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>56aad259-5324-49f7-b325-65986f0baabe</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets=analyzers: disables ModelContextProtocol.Analyzers source generator
         which emits code referencing [Description] without System.ComponentModel.
         Consistent with ProjectName.Mcp.Terminal and ProjectName.Mcp.Playwright. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="ModelContextProtocol" ExcludeAssets="analyzers" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" ExcludeAssets="analyzers" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProjectName.ServiceDefaults\ProjectName.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
