<Project>
  <ItemGroup>
    <!-- ── Aspire (13.5.2 line — matches Aspire.AppHost.Sdk 13.5.2 in AppHost.csproj) ── -->
    <!-- Bumped from 9.4.0 (2026-07-15): Aspire.Hosting.JavaScript 13.4.6 requires
         Aspire.Hosting >= 13.4.6, which triggered NU1109 package-downgrade errors
         against the old 9.4.0 pin. Verified these versions exist on NuGet for all
         packages below (Microsoft's "Aspire Orchestration Dependencies" family
         all ship in lockstep). -->
    <!-- Aspire.Hosting.AppHost intentionally NOT listed here: Aspire.AppHost.Sdk
         implicitly adds this PackageReference, and CPM forbids centrally versioning
         implicit references (NU1009 fires otherwise). -->
    <!-- ARCH-ASPIRE-BUMP-002 (2026-08-21): bumped 13.4.6 to 13.5.1, then to 13.5.2.
         A prior partial bump left Aspire.Hosting.JavaScript on 13.4.6 while the rest
         moved to 13.5.1, reasoning that its own dependency constraint
         (Aspire.Hosting >= 13.4.6) was satisfied by the >=13.4.6 bump above. WRONG.
         Got a runtime System.MethodAccessException:
         JavaScriptHostingExtensions.AddNextJsApp (compiled against 13.4.6)
         failing to call Aspire.Hosting.Utils.PathNormalizer.NormalizePathForCurrentPlatform
         at 13.5.1. These packages share internal/friend-assembly APIs that are
         NOT covered by semver dependency ranges: "ship in lockstep" means
         same exact version, not merely satisfying >= constraints. Every
         package in this family (including Aspire.Hosting.JavaScript below)
         must move together on every bump — resolved 2026-08-25 after a merge
         conflict reintroduced a 13.5.1/13.5.2 split; keeping 13.5.2 across
         the whole family and bumping Aspire.Hosting.JavaScript to match. -->
    <PackageVersion Include="Aspire.Hosting" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.2" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL.EntityFrameworkCore" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.2" />

    <!-- Microsoft Agent Framework -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows.Declarative" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows.Declarative.Mcp" Version="1.19.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.19.0" />

    <!-- Matching hosting/developer surface -->
    <PackageVersion Include="Aspire.Hosting.AgentFramework.DevUI" Version="1.19.0-preview.260822.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="1.19.0-preview.260822.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.19.0-preview.260822.1" />
    <PackageVersion Include="Microsoft.Agents.AI.DevUI" Version="1.19.0-preview.260822.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hyperlight" Version="1.19.0-preview.260822.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="1.19.0-alpha.260822.1" />

    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="13.4.1-beta.706" />
    <PackageVersion Include="Hyperlight.HyperlightSandbox.Guest.Python" Version="0.5.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Patchright" Version="1.61.0" />

    <!-- Microsoft.Extensions.AI -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0-preview.7.26381.103" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.7.26381.103" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.7.26381.103" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />

    <!-- MCP -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />

    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />

    <!-- gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.83.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.ClientFactory" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.0-rc2" />

    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>
</Project>
